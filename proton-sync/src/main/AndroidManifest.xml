<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Runtime calendar permissions this module's sync bridge needs. Declared here so the
        module documents its own requirements; they merge into :app, which already requests
        them at runtime through the existing calendar flows.
    -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

</manifest>
