<?xml version="1.0" encoding="utf-8"?>
<!--
    Cloud backup rules (API < 31 path, android:fullBackupContent).
    The Proton sync bridge's secrets MUST never enter cloud backups or device transfers
    (security-audit.md CR-1 / §2.4.19): the encrypted session file is excluded alongside its
    whole directory, and the sync-metadata database is excluded as defense in depth (it
    holds no secrets by rule, but its structure stays off backup media regardless).
-->
<full-backup-content>
    <exclude domain="file" path="proton-session/" />
    <exclude domain="database" path="proton-sync.db" />
    <exclude domain="database" path="proton-sync.db-wal" />
    <exclude domain="database" path="proton-sync.db-shm" />
</full-backup-content>
